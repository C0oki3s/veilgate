      ],
      "selectedTracesFields": [],
      "query": {
        "queryType": "builder",
        "id": "q-p12",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "logs",
              "aggregateOperator": "noop",
              "aggregateAttribute": {},
              "functions": [],
              "filters": {
                "items": [
                  {
                    "id": "p12-f1",
                    "key": {
                      "id": "body--string--tag--true",
                      "key": "body",
                      "dataType": "string",
                      "type": "tag",
                      "isColumn": true,
                      "isJSON": false
                    },
                    "op": "=",
                    "value": "request"
                  },
                  {
                    "id": "p12-f2",
                    "key": {
                      "id": "decision--string--tag--false",
                      "key": "decision",
                      "dataType": "string",
                      "type": "tag",
                      "isColumn": false,
                      "isJSON": false
                    },
                    "op": "in",
                    "value": ["tarpit", "challenge"]
                  }
                ],
                "op": "AND"
              },
              "groupBy": [],
              "expression": "A",
              "disabled": false,
              "having": [],
              "limit": null,
              "stepInterval": null,
              "orderBy": [ { "columnName": "timestamp", "order": "desc" } ],
              "legend": "",
              "pageSize": 100,
              "offset": 0
            }
          ],
          "queryFormulas": []
        },
        "promql": [ { "name": "A", "query": "", "legend": "", "disabled": false } ],
        "clickhouse_sql": [ { "name": "A", "query": "", "legend": "", "disabled": false } ]
      }
