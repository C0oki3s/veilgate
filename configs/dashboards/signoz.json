    {
      "id": "p01",
      "title": "Total Requests",
      "description": "Total proxy requests passing through VeilGate in the last 5 minutes.",
      "panelTypes": "value",
      "isStacked": false,
      "fillSpans": false,
      "bucketCount": 30,
      "bucketWidth": 0,
      "columnUnits": {},
      "mergeAllActiveQueries": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMin": 0,
      "thresholds": [],
      "yAxisUnit": "short",
      "selectedLogFields": [
        { "dataType": "string", "name": "body",      "type": "" },
        { "dataType": "string", "name": "timestamp", "type": "" }
      ],
      "selectedTracesFields": [],
      "query": {
        "queryType": "promql",
        "id": "q-p01",
        "promql": [
          { "name": "A", "query": "sum(increase(veilgate_requests_total[5m]))", "legend": "requests", "disabled": false }
        ],
        "builder": { "queryData": [], "queryFormulas": [] },
        "clickhouse_sql": [ { "name": "A", "query": "", "legend": "", "disabled": false } ]
      }
    },

